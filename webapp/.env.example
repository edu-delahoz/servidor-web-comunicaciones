# Copie este archivo a ".env" y cambie los valores en produccion
# cp .env.example .env

# Puerto en el que escucha la aplicacion Node
PORT=3000

# Escuche solo en loopback si usa un proxy inverso (nginx). Use 0.0.0.0 para acceso directo.
HOST=127.0.0.1

# Secreto de sesion: genere uno con:  openssl rand -hex 32
SESSION_SECRET=cambie_este_valor_por_uno_aleatorio_largo

# Poner en "true" cuando el sitio se sirva por HTTPS (recomendado). Marca la cookie como Secure.
SECURE_COOKIES=false

# Credenciales del usuario administrador inicial (se crea al ejecutar init-db)
ADMIN_USER=admin
ADMIN_PASSWORD=Cambiar.Este.Password.2026
