<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <title><%= title %> — Servidor Web · Entrega I</title>
  <link rel="stylesheet" href="/public/styles.css?v=2">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="7" rx="2"/>
          <rect x="3" y="13" width="18" height="7" rx="2"/>
          <path d="M7 7.5h.01M7 16.5h.01"/>
        </svg>
      </span>
      Servidor Web
    </a>
    <% if (user) { %>
      <nav aria-label="Principal">
        <a class="nav-link<%= (typeof active !== 'undefined' && active === 'clientes') ? ' is-active' : '' %>" href="/clientes">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="8" r="3.5"/>
            <path d="M3.5 19.5c0-3 2.5-5 5.5-5s5.5 2 5.5 5"/>
            <path d="M16 8.5a3 3 0 0 1 0 5.6M17.5 14.8c1.8.7 3 2.2 3 4.2"/>
          </svg>
          Clientes
        </a>
        <a class="nav-link<%= (typeof active !== 'undefined' && active === 'deploys') ? ' is-active' : '' %>" href="/deploys">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3 3 19h18z"/>
          </svg>
          Deploys
        </a>
        <span class="nav-user">
          <span class="nav-avatar" aria-hidden="true"><%= user.username.slice(0, 2) %></span>
          <span><%= user.username %></span>
        </span>
        <form method="POST" action="/logout" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-small">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h3"/>
              <path d="M14 16l4-4-4-4M18 12H9"/>
            </svg>
            Salir
          </button>
        </form>
      </nav>
    <% } %>
  </header>
  <main class="container">
