<%- include('partials/header') %>

<div class="card card-narrow">
  <div class="cuenta-head">
    <span class="nav-avatar cuenta-avatar" aria-hidden="true"><%= cuenta.username.slice(0, 2) %></span>
    <div>
      <h1><%= cuenta.username %></h1>
      <p class="page-subtitle">Cuenta creada el <%= (cuenta.created_at || '').slice(0, 10) %></p>
    </div>
  </div>

  <h2 class="section-title">Cambiar contraseña</h2>

  <% if (exito) { %>
    <div class="alert alert-ok" role="status">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9"/>
        <path d="m8.5 12.2 2.4 2.4 4.6-5"/>
      </svg>
      <span><%= exito %></span>
    </div>
  <% } %>

  <% if (errores && errores.length) { %>
    <div class="alert alert-error" role="alert">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9"/>
        <path d="M12 8v4.5M12 15.8h.01"/>
      </svg>
      <ul>
        <% errores.forEach(function(e) { %><li><%= e %></li><% }); %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="/cuenta/password" autocomplete="off">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="field">
      <label for="actual">Contraseña actual</label>
      <input type="password" id="actual" name="actual" required maxlength="200">
    </div>

    <div class="field">
      <label for="nueva">Nueva contraseña</label>
      <input type="password" id="nueva" name="nueva" required maxlength="200" placeholder="Mínimo 8 caracteres">
    </div>

    <div class="field">
      <label for="confirmar">Confirmar nueva contraseña</label>
      <input type="password" id="confirmar" name="confirmar" required maxlength="200">
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Actualizar contraseña</button>
      <a href="/clientes" class="btn">Volver</a>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
