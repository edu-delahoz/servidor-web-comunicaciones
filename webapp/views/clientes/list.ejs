<%- include('../partials/header') %>

<div class="page-head">
  <div>
    <h1>Clientes<% if (clientes.length) { %><span class="count-pill"><%= clientes.length %></span><% } %></h1>
    <p class="page-subtitle">Registro de clientes almacenado en la base de datos local.</p>
  </div>
  <a href="/clientes/nuevo" class="btn btn-primary">
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M12 5v14M5 12h14"/>
    </svg>
    Nuevo cliente
  </a>
</div>

<% if (clientes.length === 0) { %>
  <div class="card empty-state">
    <span class="empty-glyph" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="8" r="3.5"/>
        <path d="M3.5 19.5c0-3 2.5-5 5.5-5s5.5 2 5.5 5"/>
        <path d="M17 8h4M19 6v4"/>
      </svg>
    </span>
    <h2>Sin clientes todavía</h2>
    <p>Cree el primer registro para empezar a usar el CRUD.</p>
    <a href="/clientes/nuevo" class="btn btn-primary">Crear el primero</a>
  </div>
<% } else { %>
  <div class="card table-card">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>ID</th><th>Nombre</th><th>Email</th><th>Teléfono</th><th>Notas</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% clientes.forEach(function(c) { %>
            <tr>
              <td class="cell-id">#<%= c.id %></td>
              <td>
                <span class="cell-person">
                  <span class="avatar" aria-hidden="true"><%= c.nombre.trim().slice(0, 1) %></span>
                  <%= c.nombre %>
                </span>
              </td>
              <td class="cell-muted"><%= c.email %></td>
              <td class="cell-muted cell-phone"><%= c.telefono || '—' %></td>
              <td class="cell-notes" title="<%= c.notas %>"><%= c.notas || '—' %></td>
              <td class="actions">
                <a href="/clientes/<%= c.id %>/editar" class="btn btn-icon" title="Editar" aria-label="Editar a <%= c.nombre %>">
                  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14.5 5.5 18.5 9.5 8 20H4v-4z"/>
                    <path d="M13 7l4 4"/>
                  </svg>
                </a>
                <form method="POST" action="/clientes/<%= c.id %>/eliminar" class="inline" data-confirm="Se eliminará a <%= c.nombre %> de forma permanente.">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-icon btn-danger" title="Eliminar" aria-label="Eliminar a <%= c.nombre %>">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M6.5 7l.8 12a1.5 1.5 0 0 0 1.5 1.4h6.4a1.5 1.5 0 0 0 1.5-1.4l.8-12"/>
                      <path d="M10 11v6M14 11v6"/>
                    </svg>
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
