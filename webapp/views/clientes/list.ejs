<%- include('../partials/header') %>

<div class="card">
  <div class="card-head">
    <h1>Clientes</h1>
    <a href="/clientes/nuevo" class="btn btn-primary">+ Nuevo cliente</a>
  </div>

  <% if (clientes.length === 0) { %>
    <p class="muted">No hay clientes registrados. Cree el primero.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>ID</th><th>Nombre</th><th>Email</th><th>Telefono</th><th>Notas</th><th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% clientes.forEach(function(c) { %>
            <tr>
              <td><%= c.id %></td>
              <td><%= c.nombre %></td>
              <td><%= c.email %></td>
              <td><%= c.telefono %></td>
              <td><%= c.notas %></td>
              <td class="actions">
                <a href="/clientes/<%= c.id %>/editar" class="btn btn-small">Editar</a>
                <form method="POST" action="/clientes/<%= c.id %>/eliminar" class="inline" onsubmit="return confirm('Eliminar este cliente?');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-small btn-danger">Eliminar</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
